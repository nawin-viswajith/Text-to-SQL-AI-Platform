APP_ENV=dev
API_PREFIX=/api/v1

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=readonly_password
MYSQL_DATABASE=analytics

SQL_DEFAULT_LIMIT=100
SQL_MAX_LIMIT=1000

CHROMA_PATH=.chroma
CHROMA_COLLECTION=schema_metadata
RAG_RETRIEVAL_K=4
RAG_FETCH_K=12
RAG_MMR_LAMBDA=0.7

DOCS_TOKEN=change-me
API_TOKEN=change-me-api-token
RBAC_ENABLED=false

LANGSMITH_TRACING=false
LANGSMITH_PROJECT=enterprise-text2sql
LANGSMITH_API_KEY=
RAGAS_ENABLED=true
RAGAS_USE_FALLBACK=true
